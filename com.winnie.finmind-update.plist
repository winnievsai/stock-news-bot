<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.winnie.finmind-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/caixunwei/Desktop/搜集股票資訊/run.sh</string>
